# ============================================================
#  Marina One v2.0 — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais
# ============================================================

# ── Banco de Dados PostgreSQL ────────────────────────────────
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=postgres://marinaone:senha_forte_aqui@localhost:5432/marinaone

# Use DB_SSL=true em produção (Neon, Railway, Render etc)
DB_SSL=false

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
JWT_SECRET=troque_por_uma_string_aleatoria_e_longa_de_pelo_menos_32_chars

# ── SaaS — Multi-Tenant ──────────────────────────────────────
BASE_DOMAIN=marinaone.com.br

# Super-admin (Arthur) — acessa /api/superadmin/*
SUPER_ADMIN_EMAIL=arthur@marinaone.com.br
SUPER_ADMIN_PASSWORD=troque_esta_senha_imediatamente

# ── Single-Tenant (opcional) ─────────────────────────────────
# Defina estas variáveis para rodar a instância como single-tenant
# sem precisar de subdomínio. Ideal para deploy inicial ou testes.
# SINGLE_TENANT_SLUG=porto-belo
# SINGLE_TENANT_NAME=Marina Porto Belo
# ADMIN_EMAIL=admin@marina.com
# ADMIN_PASSWORD=marina123
