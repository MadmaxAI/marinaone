{
  "name": "marina-one",
  "version": "2.3.66",
  "description": "Sistema SaaS de gestão integrada de marina — Multi-Tenant PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "provision": "node -e \"require('./src/db/migrate').provisionTenant(process.argv[1], { marinaName: process.argv[2] }).catch(console.error)\"",
    "legacy": "node server.legacy.js",
    "publicar": "bash publicar.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "postgres": "^3.4.4"
  },
  "keywords": [
    "marina",
    "saas",
    "multitenant",
    "nodejs",
    "postgresql"
  ],
  "author": "MadmaxAI",
  "license": "MIT"
}
